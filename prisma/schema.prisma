model MedAllianceAdminReviewCase {
  id              String                @id @default(uuid())
  organization_id String
  reason_code     AdminReviewReasonCode
  status          AdminReviewStatus     @default(open)
  // Scopes the case to a specific line item for unmatched_line_item/ambiguous_line_item cases
  // (one company can have several unmatched line items at once — each needs its own case).
  // Null for every other reason_code, which stays org-scoped as before.
  hubspot_line_item_snapshot_id String?
  metadata Json?
  resolved_by_id String?
  resolved_at    DateTime?
  resolution      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization              @relation(fields: [organization_id], references: [id])
  resolvedBy   USER?                     @relation("ReviewCaseResolvedBy", fields: [resolved_by_id], references: [id])
  lineItem     HubspotLineItemSnapshot?  @relation(fields: [hubspot_line_item_snapshot_id], references: [id])

  // NULLS NOT DISTINCT would be ideal here, but Postgres unique indexes already treat multiple
  // NULLs in hubspot_line_item_snapshot_id as distinct rows — which is exactly what we want:
  // org-scoped reason codes (line item = null) keep today's single-open-case-per-reason behavior,
  // while line-item-scoped reason codes get one open case per line item.
  @@unique([organization_id, reason_code, status, hubspot_line_item_snapshot_id], name: "uq_open_review_case")
  @@index([organization_id], map: "idx_review_cases_org")
  @@index([status], map: "idx_review_cases_status")
  @@index([reason_code], map: "idx_review_cases_reason_code")
  @@index([hubspot_line_item_snapshot_id], map: "idx_review_cases_line_item")
}

// Per-organization billing settings. One row per Organization (1:1). Everything the
// invoice generation worker (InvoiceWorker) needs to know about *how* to bill a given
// org lives here — cycle timing, pricing fallbacks, automation flags, and Stripe/Hubstaff
// linkage. Organizations without a row here are not eligible for automated invoicing.
model InvoiceConfiguration {
  id                               String             @id @default(uuid())
  organization_id                  String             @unique

  // Hubstaff org/team id — source of tracked-hours data for hourly billing lines.
  hubstaff_id                      String?
  // HubSpot company id — used to keep this configuration's billing fields in sync with CRM.
  hubspot_id                       String?

  // Determines whether invoices are issued before or after actual cycle close.
  billing_mode                     BillingMode        @default(arrears)

  // monthly / biweekly / weekly / custom
  billing_frequency                BillingFrequency   @default(monthly)

  // Currency for invoices
  billing_currency                 String             @default("USD")

  // Net terms used when generating due_date
  payment_terms_days               Int                @default(7)

  // Which day cycle starts for monthly billing (1..28 recommended)
  cycle_anchor_day                 Int?

  // Whether invoices auto-submit for review after generation
  auto_submit_invoices            Boolean            @default(false)

  // Whether invoices auto-publish after approval
  auto_publish_invoices           Boolean            @default(false)

  // Whether Stripe sync should happen on publish
  auto_sync_to_stripe             Boolean            @default(true)

  // ========================================================================
  // PREBILLING / RECONCILIATION
  // ========================================================================

  // Whether reconciliation is required after each billed cycle
  requires_reconciliation         Boolean            @default(false)

  // How many days after cycle end reconciliation should run
  reconciliation_delay_days       Int                @default(0)

  // Open credit carried forward to future invoices
  credit_balance                  Decimal            @db.Decimal(14,2) @default(0)

  // Open debit carried forward to future invoices
  debit_balance                   Decimal            @db.Decimal(14,2) @default(0)

  // If true, apply available credit automatically to next invoice
  auto_apply_credits              Boolean            @default(true)

  // ========================================================================
  // PRICING DEFAULTS
  // ========================================================================

  default_operations_cost         Decimal?           @db.Decimal(14,2)
  default_medvirtual_fee          Decimal?           @db.Decimal(14,2)

  // default hourly rate fallback when worker line has none
  default_hourly_rate             Decimal?           @db.Decimal(14,2)

  // ========================================================================
  // PAYMENT / COLLECTIONS
  // ========================================================================

  // Stripe customer id
  stripe_customer_id              String?            @unique

  // If org can accumulate unpaid balances
  allow_outstanding_balance       Boolean            @default(true)

  // Pause publishing new invoices if unpaid debt exceeds threshold
  credit_hold_threshold           Decimal?           @db.Decimal(14,2)

  // ========================================================================
  // OPERATIONS FLAGS
  // ========================================================================

  // Show fee components separately on rendered invoice
  show_fee_breakdown_on_invoice   Boolean            @default(false)

  // Require super admin approval before publish
  require_super_admin_publish     Boolean            @default(false)

  // ========================================================================
  // AUDIT / STATUS
  // ========================================================================

  billing_notes                   String?

  billing_activated_at            DateTime?
  billing_paused_at               DateTime?
  
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt

  organization                    Organization       @relation(fields: [organization_id], references: [id])

  @@index([organization_id], map: "idx_invoice_configurations_org_id")
  @@index([stripe_customer_id], map: "idx_invoice_configurations_stripe_id")
}

