model AffiliateCommission {
  id                            String           @id @default(uuid())
  affiliate_id                  String
  affiliate_profile_id          String
  organization_id               String
  hubspot_invoice_snapshot_id   String
  // The specific line item (collaborator payment) this commission was computed from.
  // Nullable to preserve legacy pre-per-collaborator rows created under the old invoice-level logic.
  hubspot_line_item_snapshot_id String?
  // Denormalized for fast per-collaborator queries/reporting without joining through the line item.
  staff_id                      String?
  commission_percent_snapshot   Decimal          @db.Decimal(5, 2)
  base_amount_snapshot          Decimal          @db.Decimal(14, 2)
  commission_amount             Decimal          @db.Decimal(14, 2)
  status                        CommissionStatus @default(detected)
  idempotency_key               String           @unique
  admin_decision_by             String?
  admin_decision_reason         String?
  admin_decision_at             DateTime?
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  affiliate                USER                               @relation("AffiliateCommissions", fields: [affiliate_id], references: [id])
  // Back-relation to AffiliateProfile — enables AffiliateProfile.commissions[]
  affiliateProfile         AffiliateProfile                   @relation(fields: [affiliate_profile_id], references: [id])
  organization             Organization                       @relation(fields: [organization_id], references: [id])
  hubspotInvoiceSnapshot   HubspotInvoiceSnapshot             @relation(fields: [hubspot_invoice_snapshot_id], references: [id])
  hubspotLineItemSnapshot  HubspotLineItemSnapshot?           @relation(fields: [hubspot_line_item_snapshot_id], references: [id])
  staff                    Staff?                             @relation(fields: [staff_id], references: [id])
  adminDecisionBy          USER?                              @relation("CommissionAdminDecision", fields: [admin_decision_by], references: [id])
  // Junction records linking this commission to payout requests
  payoutRequestCommissions AffiliatePayoutRequestCommission[]

  // Enforces one commission per line item — supersedes the old invoice-level uniqueness now that
  // commission is computed per collaborator payment, not per whole invoice. Legacy rows with a null
  // hubspot_line_item_snapshot_id are exempt (Postgres treats NULLs as distinct for unique indexes).
  @@unique([hubspot_line_item_snapshot_id], map: "uq_affiliate_commissions_line_item_snapshot")
  // Scoped listing: all commissions for a given affiliate filtered by status
  @@index([affiliate_id, status], map: "idx_affiliate_commissions_affiliate_status")
  // Scoped listing: all commissions for a given organization filtered by status
  @@index([organization_id, status], map: "idx_affiliate_commissions_org_status")
  @@index([status], map: "idx_affiliate_commissions_status")
  @@index([staff_id], map: "idx_affiliate_commissions_staff_id")
  @@index([hubspot_invoice_snapshot_id], map: "idx_affiliate_commissions_invoice_snapshot_id")
}

