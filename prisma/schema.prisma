generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL") // LOCAL_DATABASE_URL | DATABASE_URL | PROD_DATABASE_URL
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Provider-neutral receipt and processing log for inbound webhooks. Only Stripe is
// wired into this table today; keeping the schema generic lets another provider be
// added later without changing how that provider's webhook is currently handled.
enum WebhookProvider {
  stripe
}

enum WebhookStatus {
  received
  processing
  processed
  failed
  ignored
}

model WebhookLog {
  id                    String          @id @default(uuid())
  provider              WebhookProvider
  provider_event_id     String
  event_type            String
  provider_object_id    String?
  provider_object_type  String?
  api_version           String?
  livemode              Boolean?
  payload               Json

  status                WebhookStatus   @default(received)
  delivery_count        Int             @default(1)
  replay_count          Int             @default(0)
  error_message         String?

  provider_created_at   DateTime?
  processing_started_at DateTime?
  processed_at          DateTime?
  last_received_at      DateTime        @default(now())
  last_replayed_at      DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([provider, provider_event_id])
  @@index([provider, event_type, createdAt], map: "idx_webhook_log_provider_event_created")
  @@index([status, createdAt], map: "idx_webhook_log_status_created")
  @@index([provider_object_id], map: "idx_webhook_log_provider_object")
}

model USER {
  id                           String               @id @default(uuid())
  email                        String               @unique
  organization_id              String?
  organization_name            String
  first_name                   String
  last_name                    String
  phone                        String
  avatar                       String
  job_title                    String
  role                         String
  workos_id                    String
  password                     String               @db.VarChar(255)
  authentication_method        String
  status                       String
  status_before_deactivation   String?
  verified                     Boolean              @default(false)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  activatedAt                  DateTime?
  is_organization_owner        Boolean              @default(false)
  createdByMethod              String               @default("self_signup")
  createdByUserId              String?
  hubspot_id                   String?              @unique
  hubspot_contact_id           String?              @unique
  email_invitations            EmailInvitation[]
  email_verifications          EmailVerification[]
  hireRequestsSourcingAssigned HireRequest[]        @relation("AssignedSourcing")
  hireRequestsStaffingAssigned HireRequest[]        @relation("AssignedStaffing")
  hireRequestsAssignedMany     HireRequest[]        @relation("AssignedUsers")
  hireRequestsCreated          HireRequest[]        @relation("HireRequestCreatedBy")
  panelCandidatesCreated       PanelCandidate[]     @relation("PanelCandidateCreatedBy")
  adminOrganizations           Organization[]       @relation("OrganizationAdmin")
  ownedOrganizations           Organization[]       @relation("OrganizationOwner")
  sessions                     Session[]
  sessionActivityPings         SessionActivity[]
  tickets                      Ticket[]
  ticketsCreated               Ticket[]             @relation("TicketCreatedBy")
  TicketNotes                  TicketNotes[]
  createdBy                    USER?                @relation("UserCreatedBy", fields: [createdByUserId], references: [id])
  createdUsers                 USER[]               @relation("UserCreatedBy")
  organization                 Organization?        @relation(fields: [organization_id], references: [id])
  talentPoolLeads              TalentPoolLead[]
  PasswordResetTokens          PasswordResetToken[]

  contact Contact?

  // --- Med Alliance relations ---
  // One-to-one affiliate profile storing commission settings and payout preferences
  affiliateProfile          AffiliateProfile?
  // Organizations this user referred into the Med Alliance program
  referredOrganizations     Organization[]               @relation("OrganizationReferredBy")
  // Organizations where this user was selected as the staff contact by an affiliate
  referToOrganizations      Organization[]               @relation("OrganizationReferTo")
  // Payout requests submitted by this user as an affiliate
  payoutRequestsAsAffiliate AffiliatePayoutRequest[]     @relation("AffiliatePayoutRequests")
  // Payout requests approved or rejected by this admin user
  payoutApprovals           AffiliatePayoutRequest[]     @relation("PayoutApprovedBy")
  // Payout requests moved to under_review by this admin user
  payoutReviews             AffiliatePayoutRequest[]     @relation("PayoutReviewedBy")
  // Notes authored on payout requests
  payoutRequestNotes        PayoutRequestNote[]          @relation("PayoutRequestNoteAuthor")
  // Payout requests cancelled by this admin user
  payoutCancellations       AffiliatePayoutRequest[]     @relation("PayoutCancelledBy")
  // Commission records where this admin user made the eligibility decision
  commissionAdminDecisions  AffiliateCommission[]        @relation("CommissionAdminDecision")
  // Commissions linked to this user as the affiliate owner
  affiliateCommissions      AffiliateCommission[]        @relation("AffiliateCommissions")
  // Audit log entries where this user was the acting subject
  medAllianceAuditActorLogs MedAllianceAuditLog[]        @relation("MedAllianceAuditActor")
  // Hubspot audit log entries where this user triggered the API call
  hubspotAuditLogs          HubspotAuditLog[]            @relation("HubspotAuditActor")
  // Ticket audit log entries where this user was the acting subject
  ticketAuditActorLogs      TicketAuditLog[]             @relation("TicketAuditActor")
  // Candidate audit log entries where this user was the acting subject
  candidateAuditActorLogs   CandidateAuditLog[]          @relation("CandidateAuditActor")
  // Offer panel audit log entries where this user was the acting subject
  offerPanelAuditLogs       OfferPanelAuditLog[]         @relation("OfferPanelAuditActor")
  // Tickets this user soft-deleted
  ticketsDeleted            Ticket[]                     @relation("TicketDeletedBy")
  // MA-006 review cases resolved by this admin user
  resolvedReviewCases       MedAllianceAdminReviewCase[] @relation("ReviewCaseResolvedBy")

  // --- Invoicing relations ---
  invoicesCreated               Invoice[]                      @relation("InvoiceCreatedBy")
  invoicesVoided                Invoice[]                      @relation("InvoiceVoidedBy")
  invoiceVersionsReviewed       InvoiceVersion[]               @relation("InvoiceVersionReviewedBy")
  invoiceVersionsApproved       InvoiceVersion[]               @relation("InvoiceVersionApprovedBy")
  invoiceVersionsPublished      InvoiceVersion[]               @relation("InvoiceVersionPublishedBy")
  invoiceVersionsCreated        InvoiceVersion[]               @relation("InvoiceVersionCreatedBy")
  invoiceLinesCreated           InvoiceLineItem[]               @relation("InvoiceLineCreatedBy")
  invoiceLineAdjustments        InvoiceLineAdjustmentHistory[]  @relation("InvoiceLineAdjustmentChangedBy")
  invoiceReconciliationsCreated InvoiceLineReconciliation[]     @relation("InvoiceReconCreatedBy")
  invoiceReviewsSubmitted       InvoiceReview[]                 @relation("InvoiceReviewSubmittedBy")
  invoiceReviewsReviewed        InvoiceReview[]                 @relation("InvoiceReviewReviewedBy")
  invoiceComments                InvoiceComment[]               @relation("InvoiceCommentAuthor")
  invoiceAuditActorLogs         InvoiceAuditLog[]               @relation("InvoiceAuditActor")

  // --- Offer Panels relations ---
  offerPanelsCreated     OfferPanel[] @relation("OfferPanelCreatedBy")
  offerPanelsAsRecipient OfferPanel[] @relation("OfferPanelRecipientUser")

  // --- Bill.com per-user credentials (admin's own bill.com login/session) ---
  billcom_session_id         String? // only ever a trusted, MFA-confirmed session
  billcom_session_expires    DateTime?
  billcom_pending_session_id String? // transient, untrusted session in-flight during MFA/phone-setup
  billcom_remember_me_id     String?
  billcom_device             String?

  // Multi Business Unit — tags the BU slug that caused this user to be soft-deactivated
  // (cron reconcile / dormant BU). Cleared on reactivation.
  deactivated_by_bu String?

  // Onboarding tour — set only when the user explicitly checks "Don't show this
  // again" in the tour card. Global across devices/browsers. Closing/skipping
  // the tour WITHOUT checking the box does NOT set this.
  onboarding_tour_dismissed Boolean @default(false)

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@index([organization_id], map: "idx_users_organization_id")
  @@index([status], map: "idx_users_status")
  @@index([is_organization_owner], map: "idx_users_is_organization_owner")
  @@index([createdByMethod], map: "idx_users_created_by_method")
  @@index([createdByUserId], map: "idx_users_created_by_user_id")
  @@index([deactivated_by_bu], map: "idx_users_deactivated_by_bu")
}

model Session {
  id            String            @id @default(uuid())
  userId        String
  token         String
  createdAt     DateTime          @default(now())
  expiresAt     DateTime
  isRevoked     Boolean           @default(false)
  user          USER              @relation(fields: [userId], references: [id])
  activityPings SessionActivity[]
}

model SessionActivity {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  scope     String // "talent_pool" | "platform" — route bucket active at ping time
  pingedAt  DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
  user      USER     @relation(fields: [userId], references: [id])

  @@index([userId, pingedAt])
  @@index([sessionId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  verified  Boolean  @default(false)
  user      USER     @relation(fields: [userId], references: [id])
}

model EmailInvitation {
  id         String   @id @default(uuid())
  userId     String
  code       String
  email_from String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  verified   Boolean  @default(false)
  user       USER     @relation(fields: [userId], references: [id])
}

model Organization {
  id                   String             @id @default(uuid())
  name                 String
  email                String?
  hubspot_id           String?            @unique
  createdAt            DateTime           @default(now())
  deletedAt            DateTime?
  admin_id             String?
  description          String?
  owner_id             String?
  date_became_client   DateTime?
  date_founded         DateTime?
  date_joined          DateTime?
  industry             String?
  location             String?
  number_of_employees  Int?
  organization_role    OrganizationRole   @default(prospect)
  phone                String?
  services             String[]
  signed_document_date DateTime?
  signed_document_url  String?
  updatedAt            DateTime           @updatedAt
  website_url          String?
  status               OrganizationStatus @default(active)
  specialties          String[]
  address              String?
  city                 String?
  postal_code          String?
  state                String?
  business_unit        String?
  source               String?
  type                 String?

  // Primary contact at the referred company (collected at referral time for HubSpot import).
  contact_first_name String?
  contact_last_name  String?
  contact_email      String?

  // Immutable snapshot of the referral submission form, captured once at creation time.
  // Never mutated afterward — protects against HubSpot sync silently overwriting
  // name/industry/location/phone/website_url on the live row. Null for organizations
  // created before this field existed.
  referral_submission_snapshot Json?

  // User ID of the affiliate who referred this organization into the Med Alliance program
  referred_by_affiliate_id String?

  // Internal staff member (concierge) the affiliate selected to handle this referral
  refer_to_user_id String?
  referToUser      USER?   @relation("OrganizationReferTo", fields: [refer_to_user_id], references: [id])

  // Med Alliance eligibility status — only set for referred organizations (referred_by_affiliate_id IS NOT NULL).
  // 'pending_confirmation' is the resting state (shown to users as "Pending"): new referrals start here and stay
  // here through every non-deployed pipeline stage. Confirm/Block become available once referral_stage = deployed.
  med_alliance_referral_status MedAllianceReferralStatus?
  // Human-readable reason stored when referral is blocked (also written to MedAllianceAuditLog).
  // Cleared when status transitions to 'expired' — expiry no longer encodes itself as a reason string here.
  med_alliance_block_reason    String?
  // Admin note recorded when eligibility is manually approved
  med_alliance_approval_note   String?
  // Anchor timestamp for the eligibility window — set to deployment_date (or first paid invoice date as a
  // fallback) when the org is deployed; used by approveEligibility's backfill computation and for display.
  eligibility_start_at         DateTime?
  // Audit record of the first paid invoice date that triggered eligibility; never cleared after being set.
  first_paid_invoice_at        DateTime?
  // Deployment date synced from HubSpot organization.deploy_date_of_first_va; preferred over first_paid_invoice_at for display.
  // Confirm/Block eligibility actions are only available once this is set and in the past. More than 365 days
  // in the past, the org is automatically moved to 'expired' (via webhook, sync, or the expiry cron sweep).
  deployment_date              DateTime?
  // Pipeline stage tracking where this referral is in the sales-to-deployment lifecycle.
  // 'deployed' is when eligibility decisions (Confirm/Block) become available — no waiting period.
  referral_stage               ReferralStage?             @default(referred)

  // HubSpot sync state — only relevant for referred organizations
  // 'pending' | 'synced' | 'no_match' | 'multiple_matches' | 'error'
  hubspot_sync_status String?
  // Last sync error message, cleared on successful sync
  hubspot_sync_error  String?
  // Timestamp of the last successful HubSpot sync
  hubspot_synced_at   DateTime?

  // Multi Business Unit — tags the BU slug that caused this org to be soft-deleted
  // (cron reconcile / dormant BU). Cleared on reactivation. Used to find the exact
  // set of objects to restore when a super-admin re-activates a BU.
  deactivated_by_bu String?

  hire_requests           HireRequest[]
  admin                   USER?                   @relation("OrganizationAdmin", fields: [admin_id], references: [id], onDelete: Restrict)
  owner                   USER?                   @relation("OrganizationOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  organization_candidates OrganizationCandidate[]
  staff                   Staff[]
  tickets                 Ticket[]
  users                   USER[]

  // The affiliate user who referred this organization; null for organizations not coming from Med Alliance
  referredByAffiliate     USER?                        @relation("OrganizationReferredBy", fields: [referred_by_affiliate_id], references: [id])
  // Commission records generated from invoices tied to this organization
  affiliateCommissions    AffiliateCommission[]
  // HubSpot invoice snapshots pulled during sync for this organization
  hubspotInvoiceSnapshots HubspotInvoiceSnapshot[]
  // MA-006 admin review cases opened for this referred organization
  adminReviewCases        MedAllianceAdminReviewCase[]
  // Invoicing relations
  invoiceConfiguration        InvoiceConfiguration?
  invoices                    Invoice[]
  invoiceLineReconciliations  InvoiceLineReconciliation[]
  billingLedgerEntries        BillingLedgerEntry[]
  contacts                Contact[]
  offerPanelsAsRecipient  OfferPanel[]                 @relation("OfferPanelRecipientCompany")

  @@index([hubspot_id], map: "idx_organizations_hubspot_id")
  @@index([status], map: "idx_organizations_status")
  @@index([name], map: "idx_organizations_name")
  @@index([admin_id], map: "idx_organizations_admin_id")
  @@index([owner_id], map: "idx_organizations_owner_id")
  @@index([organization_role], map: "idx_organizations_role")
  @@index([industry], map: "idx_organizations_industry")
  // Lookup organizations referred by a specific affiliate
  @@index([referred_by_affiliate_id], map: "idx_organizations_referred_by")
  // Scoped listing: affiliate's referred orgs filtered by status
  @@index([referred_by_affiliate_id, status], map: "idx_organizations_affiliate_status")
  // Lookup organizations assigned to a specific staff member
  @@index([refer_to_user_id], map: "idx_organizations_refer_to_user")
  // Med Alliance pipeline: find deployed companies ready for eligibility promotion
  @@index([referral_stage, eligibility_start_at], map: "idx_organizations_referral_stage")
  // Multi Business Unit — reactivation lookup by the BU slug that deactivated this org
  @@index([deactivated_by_bu], map: "idx_organizations_deactivated_by_bu")
}

