// Append-only audit trail for all Hubspot API interactions (outbound calls and inbound webhooks).
// Never soft-delete or mutate records. entity_type + entity_id act as a polymorphic reference.
// actor_user_id is set for human users; actor_label holds 'WebhookHubspot', 'CronJob',
// or 'BulkSync' for non-human sources.
model HubspotAuditLog {
  id                  String             @id @default(uuid())
  actor_user_id       String?
  actor_label         String?
  entity_type         HubspotEntityType
  entity_id           String
  hubspot_object_id   String?
  hubspot_object_type String
  action              HubspotAuditAction
  source              HubspotAuditSource @default(user_action)
  success             Boolean
  payload             Json?
  response            Json?
  error_code          String?
  error_message       String?
  createdAt           DateTime           @default(now())

  actorUser USER? @relation("HubspotAuditActor", fields: [actor_user_id], references: [id])

  @@index([entity_type, entity_id, createdAt], map: "idx_hs_audit_entity_timeline")
  @@index([actor_user_id], map: "idx_hs_audit_actor")
  @@index([actor_label], map: "idx_hs_audit_actor_label")
  @@index([source], map: "idx_hs_audit_source")
  @@index([success], map: "idx_hs_audit_success")
  @@index([createdAt], map: "idx_hs_audit_created_at")
}

// Append-only audit trail for the Ticket lifecycle. Never soft-delete or mutate records.
//
// ticket_id is deliberately NOT a foreign key: the log must survive a future hard purge of the
// ticket row (data retention / erasure requests), matching MedAllianceAuditLog.entity_id and
// HubspotAuditLog.entity_id.
//
// `event` is a plain String rather than an enum because ticket lifecycle events are an open,
// business-defined set that grows over time; each new enum value would cost a migration.
// Compile-time safety comes from the TICKET_AUDIT_EVENTS union in ticket-audit.service.ts.
// `source` stays an enum — that set genuinely is closed.
//
// PII: `before`/`after` hold ticket-column state only and never carry ticket `description`,
// note content, or recipient emails. `title` is stored only for system-generated ticket types.
model TicketAuditLog {
  id            String            @id @default(uuid())
  ticket_id     String
  actor_user_id String?
  // Denormalized actor display name, so the log stays readable after a user is hard-deleted.
  actor_label   String?
  event         String
  old_status    String?
  new_status    String?
  reason        String?
  source        TicketAuditSource @default(user)
  before        Json?
  after         Json?
  metadata      Json?
  createdAt     DateTime          @default(now())

  actorUser USER? @relation("TicketAuditActor", fields: [actor_user_id], references: [id])

  @@index([ticket_id, createdAt], map: "idx_ticket_audit_timeline")
  @@index([actor_user_id], map: "idx_ticket_audit_actor")
  @@index([event], map: "idx_ticket_audit_event")
  @@index([createdAt], map: "idx_ticket_audit_created_at")
}

enum TicketAuditSource {
  user
  system
  cron
  webhook
}

