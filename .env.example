PORT
DATABASE_URL
WORKOS_CLIENT_ID
WORKOS_API_KEY
WORKOS_CONNECTION
WORKOS_REDIRECT_URL
JWT_SECRET
RESEND_API_KEY
TOKEN_TIME_EXPIRED
FRONTEND_URL
HUBSPOT_ACCESS_TOKEN
HUBSPOT_CLIENT_SECRET
HUBSPOT_CUSTOM_OBJECT
HUBSPOT_CUSTOM_PIPELINE
GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI
GOOGLE_ACCESS_TOKEN
GOOGLE_REFRESH_TOKEN
OPENAI_API_KEY
OPENAI_API_KEY_RESUME_EXTRACTION
OPENAI_IMAGE_MODEL= "gpt-image-2.5-flare"

# Local dev only — in Lambda poppler comes from a layer mounted at /opt/bin.
# Leave unset to let node-poppler auto-discover a system install via `which`.
# Only set it if auto-discovery picks the wrong binary.
# macOS ARM: /opt/homebrew/bin | macOS Intel: /usr/local/bin
POPPLER_BIN_PATH

BILLCOM_USERNAME
BILLCOM_PASSWORD
BILLCOM_ORGANIZATION_ID
BILLCOM_DEV_KEY
BILLCOM_FUNDING_ACCOUNT_ID
BILLCOM_BASE_URL
BILLCOM_WEBHOOK_SECRET

PEER_ENV_API_URL= "oposite-env-api-url"
INTER_ENV_SYNC_SECRET= "shared-secret-between-envs"

# ── Environment & Redis ──────────────────────────────────────────────────────
# These five used to be a single REDIS_BASE_KEY whose *substrings* decided
# behaviour: "LOCAL" disabled all queues, "PROD" swapped in live Stripe keys.
# Renaming the namespace silently changed both. They are now explicit.
# REDIS_BASE_KEY is still honoured as a fallback, but set these instead.

# local | staging | production. Selects Stripe credentials (production reads
# AWS Secrets Manager; everything else reads STRIPE_* env vars) and the Stripe
# webhook endpoint label. An unrecognised value fails startup.
APP_ENV= "local"

# Whether BullMQ queues, workers and job scheduling run at all. Keep this
# false locally unless you are pointed at your own Redis: each enabled instance
# holds ~15-18 connections, and the shared Redis Cloud plan caps out at 30.
# An unparseable value fails startup rather than defaulting to true.
QUEUES_ENABLED= "false"

# Prefix for plain app keys. Normalised to end with exactly one ':'.
REDIS_KEY_PREFIX= "MEDVIRTUAL:LOCAL:YOURNAME:"

# Prefix for BullMQ queue keys. Normalised to have no trailing ':'.
BULLMQ_PREFIX= "MEDVIRTUAL:LOCAL:YOURNAME"

# Distinguishes concurrent local developers when labelling Stripe webhook
# endpoints, so one dev's startup does not delete another's. Local only.
INSTANCE_ID= "yourname"

REDIS_HOST
REDIS_PORT
REDIS_USERNAME
REDIS_PASSWORD

# OpenRouter fallback — engages only when OpenAI reports insufficient_quota.
# Without OPENROUTER_API_KEY the fallback is disabled and behaviour is unchanged.
OPENROUTER_API_KEY
OPENROUTER_FALLBACK_ENABLED= "true"
OPENROUTER_HTTP_REFERER= "https://medvirtual.ai"
OPENROUTER_X_TITLE= "MedVirtual"
# Comma-separated cascades; leave unset to use the built-in free-model defaults
OPENROUTER_VISION_MODELS
OPENROUTER_TEXT_MODELS
OPENROUTER_IMAGE_MODEL= "google/gemini-2.5-flash-image"

# Switches env-gated behaviour across the app: the [DEV] mail sender prefix,
# stakeholder recipient lists, and the HubSpot BCC below. Defaults to DEV when
# unset. Only the production Lambda should carry PROD.
ENVIRONMENT= "DEV" # DEV | PROD

# HubSpot BCC logging address: offer-panel emails copied here are recorded on the
# contact's CRM timeline. Applied only when ENVIRONMENT=PROD, so a local or
# staging send never reaches the real CRM. Leave empty to disable entirely.
HUBSPOT_BCC_EMAIL

# ── Observability (Sentry) ───────────────────────────────────────────────────
# Leave SENTRY_DSN empty locally: without it the SDK is a no-op. The environment
# tag comes from APP_ENV above.
SENTRY_DSN=
# Fraction of requests traced, 0 to 1. Defaults to 0.2 when unset; use 1 on
# staging where volume is low.
SENTRY_TRACES_SAMPLE_RATE=
# Commit SHA the running build was made from. Set by the deploy workflow at
# pm2 reload time, not by hand.
SENTRY_RELEASE=
